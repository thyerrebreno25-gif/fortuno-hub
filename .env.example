# PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase público
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Supabase servidor — nunca expor no navegador
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Assistente Fortuno (uso isolado da plataforma, cobrado na conta da API)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_ASSISTANT_MODEL="gpt-5.6-luna"

# Conta Azul (OAuth 2.0 por cliente)
CONTA_AZUL_CLIENT_ID="YOUR_CLIENT_ID"
CONTA_AZUL_CLIENT_SECRET="YOUR_CLIENT_SECRET"
CONTA_AZUL_REDIRECT_URI="http://localhost:3000/api/integrations/conta-azul/callback"
# 32 bytes em hexadecimal ou base64. Se omitida, usa GMAIL_TOKEN_ENCRYPTION_KEY.
INTEGRATION_TOKEN_ENCRYPTION_KEY="YOUR_32_BYTE_KEY"

# Envio de e-mails transacionais (use apenas um domínio verificado no Resend)
RESEND_API_KEY="re_YOUR_API_KEY"
MEMBERS_FROM_EMAIL="Fortuno Hub <notificacoes@hubsuporte.shop>"
SUPPORT_FROM_EMAIL="Fortuno Hub <notificacoes@hubsuporte.shop>"
OPERATIONS_FROM_EMAIL="Fortuno Hub <notificacoes@hubsuporte.shop>"

# WhatsApp Business Platform / Cloud API
# Gere um segredo próprio e use o mesmo valor ao verificar o webhook na Meta.
WHATSAPP_VERIFY_TOKEN="YOUR_RANDOM_VERIFY_TOKEN"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"
WHATSAPP_ACCESS_TOKEN="YOUR_SYSTEM_USER_OR_TEST_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
# Copie a versão mostrada na URL de exemplo da configuração da API da Meta.
WHATSAPP_GRAPH_API_VERSION="v00.0"
# Obrigatória apenas se o banco possuir mais de uma organização.
WHATSAPP_ORGANIZATION_ID="YOUR_FORTUNO_ORGANIZATION_ID"

# Banco Central do Brasil
BCB_PTAX_BASE_URL="https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata"
BCB_SGS_BASE_URL="https://api.bcb.gov.br/dados/serie/bcdata.sgs"

# Reuniões e agenda (configurar OAuth depois, uma autorização por colaborador)
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"
# Usa INTEGRATION_TOKEN_ENCRYPTION_KEY já definida acima para proteger tokens.
MEETINGS_FROM_EMAIL="Fortuno Hub <notificacoes@hubsuporte.shop>"
OPENAI_MEETING_TRANSCRIPTION_MODEL="gpt-transcribe"
# Protege os endpoints de agendamento da Vercel. Gerar um segredo aleatório.
CRON_SECRET=""
