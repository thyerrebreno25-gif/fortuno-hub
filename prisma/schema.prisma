  updatedAt    DateTime             @updatedAt

  audit      Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AuditChecklistReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([auditId, position])
  @@index([auditId, status])
}

model EmailConnection {
  id                    String    @id @default(cuid())
  organizationId        String
  provider              String    @default("GMAIL")
  email                 String
  externalId            String?
  active                Boolean   @default(true)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                String[]  @default([])
  lastSyncAt            DateTime?
  watchExpiresAt        DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, email])
  @@index([organizationId, active])
}

model ClientEmailIdentity {
  id              String   @id @default(cuid())
  clientId        String
  email           String
  normalizedEmail String
  label           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, normalizedEmail])
  @@index([normalizedEmail, active])
}

model ClientWhatsAppIdentity {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  kind           String   @default("CONTACT")
  externalId     String
  displayName    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, clientId, kind, externalId])
  @@index([organizationId, kind, externalId, active])
  @@index([clientId, active])
}

model ServiceTicket {
  id                String                @id @default(cuid())
  mergedIntoId      String?
  organizationId    String
  clientId          String?
  routingArea       ServiceRoutingArea    @default(UNKNOWN)
  routingSquad      ClientSquad?
  routingConfidence Int?
  routingReason     String?
  assignedToId      String?
  externalThreadId  String?
  source            String                @default("MANUAL")
  subject           String
  senderName        String?
  senderEmail       String
  recipientEmail    String?
  snippet           String?
  status            ServiceTicketStatus   @default(NEW)
  priority          ServiceTicketPriority @default(MEDIUM)
  isSpam            Boolean               @default(false)
  spamScore         Int?
  assignedAt        DateTime?
  receivedAt        DateTime              @default(now())
  resolvedAt        DateTime?
  firstResponseAt   DateTime?
  lastMessageAt     DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("ServiceTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages ServiceMessage[]
  history  ServiceTicketHistory[]

  @@unique([organizationId, externalThreadId])
  @@index([organizationId, status, updatedAt])
  @@index([assignedToId, status, updatedAt])
  @@index([clientId, updatedAt])
  @@index([senderEmail])
}

model ServiceMessage {
  id                String                  @id @default(cuid())
  ticketId          String
  externalMessageId String?
  deliveryStatus    String?
  statusUpdatedAt   DateTime?
  providerMetadata  Json?
  direction         ServiceMessageDirection @default(INBOUND)
  fromName          String?
  fromEmail         String
  toEmails          String[]                @default([])
  ccEmails          String[]                @default([])
  subject           String?
  textBody          String?
  htmlBody          String?
  receivedAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())

  ticket      ServiceTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments ServiceAttachment[]

  @@unique([ticketId, externalMessageId])
  @@index([ticketId, receivedAt])
  @@index([externalMessageId])
}

model ServiceAttachment {
  id                   String   @id @default(cuid())
  messageId            String
  externalAttachmentId String?
  name                 String
  mimeType             String?
  size                 Int?
  storagePath          String?
  createdAt            DateTime @default(now())

  message ServiceMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ServiceTicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  ticket ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation("ServiceTicketHistoryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
}

enum ClientSquad {
  SQUAD_1
  SQUAD_2
}

enum ServiceRoutingArea {
  ACCOUNTS_PAYABLE
  ACCOUNTS_RECEIVABLE
  GENERAL
  UNKNOWN
}

model OperationalMapping {
  id String @id @default(cuid())
  organizationId String
  clientId String?
  createdById String
  title String
  description String @default("")
  objective String @default("")
  owner String @default("")
  status String @default("DRAFT")
  data Json
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([organizationId, updatedAt])
  @@index([clientId])
}

model TeamMeeting {
  id String @id @default(cuid())
  organizationId String
  createdById String
  title String
  type String @default("Semanal de squad")
  externalEmails String[] @default([])
  generateMeet Boolean @default(false)
  meetLink String @default("")
  startsAt DateTime
  endsAt DateTime
  location String @default("")
  agenda String @default("")
  notes String @default("")
  status String @default("SCHEDULED")
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  creator User @relation("MeetingCreator", fields:[createdById], references:[id], onDelete:Restrict)
  participants MeetingParticipant[]
  actions MeetingActionItem[]
  contributions MeetingNote[]
  recordings MeetingRecording[]
  events TeamCalendarEvent[]
  deliveries MeetingDelivery[]
  @@index([organizationId, startsAt])
}
model MeetingParticipant {
  meetingId String
  userId String
  meeting TeamMeeting @relation(fields:[meetingId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([meetingId,userId])
  @@index([userId])
}
model MeetingActionItem {
  id String @id @default(cuid())
  meetingId String
  responsibleId String
  title String
  description String @default("")
  dueAt DateTime
  completedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting TeamMeeting @relation(fields:[meetingId], references:[id], onDelete:Cascade)
  responsible User @relation(fields:[responsibleId], references:[id], onDelete:Restrict)
  events TeamCalendarEvent[]
  deliveries MeetingDelivery[]
  @@index([responsibleId,completedAt,dueAt])
}
model MeetingNote {
  id String @id @default(cuid())
  meetingId String
  authorId String
  body String
  createdAt DateTime @default(now())
  meeting TeamMeeting @relation(fields:[meetingId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  @@index([meetingId,createdAt])
}
model TeamCalendarEvent {
  id String @id @default(cuid())
  organizationId String
  userId String
  sourceKey String
  meetingId String?
  actionItemId String?
  title String
  description String @default("")
  startsAt DateTime
  endsAt DateTime
  location String @default("")
  status String @default("ACTIVE")
  revision Int @default(1)
  googleSyncStatus String @default("PENDING")
  googleEventId String?
  syncError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  meeting TeamMeeting? @relation(fields:[meetingId],references:[id],onDelete:SetNull)
  actionItem MeetingActionItem? @relation(fields:[actionItemId],references:[id],onDelete:SetNull)
  @@unique([userId,sourceKey])
  @@index([organizationId,userId,startsAt])
  @@index([googleSyncStatus,updatedAt])
}
model GoogleCalendarConnection {
  id String @id @default(cuid())
  organizationId String
  userId String
  encryptedAccessToken String
  encryptedRefreshToken String
  expiresAt DateTime
  calendarId String @default("primary")
  status String @default("CONNECTED")
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([organizationId,userId])
}
model MeetingDelivery {
  id String @id @default(cuid())
  organizationId String
  userId String
  meetingId String
  actionItemId String?
  dedupeKey String @unique
  title String
  body String
  emailStatus String @default("PENDING")
  attempts Int @default(0)
  leaseUntil DateTime?
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  meeting TeamMeeting @relation(fields:[meetingId],references:[id],onDelete:Cascade)
  actionItem MeetingActionItem? @relation(fields:[actionItemId],references:[id],onDelete:Cascade)
  @@index([emailStatus,leaseUntil])
  @@index([userId,createdAt])
}
model MeetingRecording {
  id String @id @default(cuid())
  meetingId String
  uploadedById String
  name String
  mimeType String
  size Int
  storagePath String @unique
  status String @default("UPLOADING")
  transcript String @default("")
  error String?
  consentAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting TeamMeeting @relation(fields:[meetingId],references:[id],onDelete:Cascade)
  uploadedBy User @relation(fields:[uploadedById],references:[id],onDelete:Restrict)
  @@index([meetingId,createdAt])
}

model WhatsAppConnection {
  id String @id @default(cuid())
  organizationId String @unique
  serverUrl String
  tokenEncrypted String
  tokenHash String @unique
  instanceId String
  instanceName String?
  phone String?
  profileName String?
  status String @default("DISCONNECTED")
  webhookId String?
  webhookConfiguredAt DateTime?
  lastWebhookAt DateTime?
  lastCheckedAt DateTime?
  lastDisconnectedAt DateTime?
  expiresAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inbox WhatsAppWebhookInbox[]
}
model WhatsAppHistorySync {
  id String @id @default(cuid())
  connectionId String
  instanceId String
  accountPhone String
  status String @default("PENDING")
  since DateTime
  until DateTime @default(now())
  offset Int @default(0)
  queued Int @default(0)
  attempts Int @default(0)
  lastError String?
  claimedAt DateTime?
  nextRunAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([connectionId,status,createdAt])
}
model WhatsAppWebhookInbox {
  id String @id
  connectionId String
  eventType String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  lastError String?
  receivedAt DateTime @default(now())
  processedAt DateTime?
  claimedAt DateTime?
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId, status, receivedAt])
}
