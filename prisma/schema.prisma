generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MASTER
  ADMIN
  MANAGER
  OPERATOR
  CLIENT
}

enum ImportModule {
  EXCHANGE
  BANK_STATEMENT
  ACQUIRER
  CREDIT_CARD_INVOICE
  BRASILMED_RECONCILIATION
}

enum ContaAzulConnectionStatus {
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

enum PurchaseInvoiceSource {
  XML_UPLOAD
  CONTA_AZUL
}

enum PurchaseInvoiceStatus {
  PENDING_REVIEW
  READY_TO_SEND
  SENT
  FAILED
  IGNORED
}

enum PurchaseInvoiceInstallmentSource {
  XML
  MANUAL_REQUIRED
  MANUAL
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  REVIEW
  VALIDATED
  EXPORTED
  FAILED
}

enum ContaAzulFinancialExportModule {
  CREDIT_CARD_INVOICE
  ACQUIRER
}

enum ContaAzulFinancialExportStatus {
  PROCESSING
  PARTIAL
  COMPLETED
  FAILED
}

enum ContaAzulFinancialExportLineStatus {
  PENDING
  CREATED
  SETTLED
  FAILED
}

enum ContaAzulFinancialDirection {
  PAYABLE
  RECEIVABLE
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ParserKind {
  BANK_STATEMENT
  CREDIT_CARD_INVOICE
  ACQUIRER
  PAYROLL_RECONCILIATION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AcquirerReceiptRule {
  WITHOUT_ADVANCE
  AUTOMATIC_ADVANCE
  OCCASIONAL_ADVANCE
}

enum AcquirerTransactionType {
  DEBIT
  CREDIT
  PIX
  VOUCHER
  OTHER
}

enum CategoryMappingType {
  SALES_REVENUE
  MDR_FEES
  ADVANCE_FEES
  MACHINE_RENTAL_ADJUSTMENTS
  SALE_CANCELLATION
  REFUNDS_CREDITS
}

enum OnboardingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingRisk {
  ON_TIME
  AT_RISK
  OVERDUE
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  NOT_APPLICABLE
}

enum OperationActivityStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  DISREGARDED
}

enum OperationEventType {
  CREATED
  ASSIGNED
  STARTED
  PAUSED
  RESUMED
  CHECKLIST_COMPLETED
  CHECKLIST_REOPENED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  STATUS_CHANGED
  BLOCKED
  DISREGARDED
  COMPLETED
  EMAIL_SENT
  EMAIL_FAILED
  TIME_ADJUSTED
  CHECKLIST_DISREGARDED
  ACTIVITY_DELETED
}

enum OperationRecurrenceType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum OperationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClientCluster {
  A
  B
  C
}

enum OperationHolidayBehavior {
  KEEP
  PREVIOUS_BUSINESS_DAY
  NEXT_BUSINESS_DAY
  SKIP
}

enum ServiceTicketStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_INTERNAL
  RESOLVED
  SPAM
}

enum ServiceTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum AuditStatus {
  DRAFT
  ANALYZED
  IN_REVIEW
  SENT_TO_CORRECTION
  PENDING_VALIDATION
  COMPLETED
  CANCELLED
}

enum AuditFileType {
  MOVEMENTS
  DRE
  REVENUE_ANALYSIS
  CASH_FLOW
  RECEIVABLES
  PAYABLES
  BANK_STATEMENT
  ACQUIRER
  CARD_INVOICE
  OTHER
}

enum AuditFindingSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AuditFindingStatus {
  IDENTIFIED
  DISMISSED
  SENT
  IN_PROGRESS
  PENDING_VALIDATION
  VALIDATED
  RETURNED
}

enum AuditFindingSource {
  AUTOMATIC
  SUPERVISOR_CHECKLIST
}

enum AuditFinancialFlow {
  PAYABLE
  RECEIVABLE
  GENERAL
}

enum AuditChecklistStatus {
  PENDING
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum NoticeKind {
  ALERT
  REMINDER
  NOTE
}

enum NoticeScope {
  PERSONAL
  MEMBERS
  CLIENTS
  GENERAL
}

enum NoticePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AssistantConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model Organization {
  notionConnection NotionConnection?
  meetings TeamMeeting[]
  calendarEvents TeamCalendarEvent[]
  calendarConnections GoogleCalendarConnection[]
  meetingDeliveries MeetingDelivery[]
  operationalMappings OperationalMapping[]
  id        String   @id @default(cuid())
  name      String
  document  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                   OrganizationMember[]
  clients                   Client[]
  categories                Category[]
  imports                   ImportJob[]
  tickets                   SupportTicket[]
  onboardingTemplates       OnboardingTemplate[]
  onboardings               Onboarding[]
  operationProcesses        OperationProcess[]
  operationActivities       OperationActivity[]
  operationHolidays         OperationHoliday[]
  roleModulePermissions     RoleModulePermission[]
  audits                    Audit[]
  emailConnections          EmailConnection[]
  serviceTickets            ServiceTicket[]
  notices                   Notice[]
  contaAzulConnections      ContaAzulConnection[]
  purchaseInvoices          PurchaseInvoice[]
  contaAzulFinancialExports ContaAzulFinancialExport[]
  assistantConversations    AssistantConversation[]
  whatsappIdentities        ClientWhatsAppIdentity[]
}

model NotionConnection {
  organizationId String @id
  encryptedToken String
  botName String
  workspaceName String
  botId String
  connectedById String
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientSourceId String?
  clientSyncEnabled Boolean @default(false)
  clientSyncConfig Json?
  clientSyncState Json?
  clientSyncReport Json?
  clientSyncAt DateTime?
  clientSyncLeaseUntil DateTime?

}

model User {
  createdMeetings TeamMeeting[] @relation("MeetingCreator")
  meetingParticipations MeetingParticipant[]
  meetingActions MeetingActionItem[]
  meetingNotes MeetingNote[]
  calendarEvents TeamCalendarEvent[]
  calendarConnections GoogleCalendarConnection[]
  meetingDeliveries MeetingDelivery[]
  meetingRecordings MeetingRecording[]
  operationalMappings OperationalMapping[]
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                      OrganizationMember[]
  imports                          ImportJob[]
  auditLogs                        AuditLog[]
  tickets                          SupportTicket[]
  onboardingOwned                  Onboarding[]               @relation("OnboardingOwner")
  onboardingCreated                Onboarding[]               @relation("OnboardingCreator")
  onboardingTasks                  OnboardingTask[]           @relation("OnboardingTaskResponsible")
  onboardingComments               OnboardingComment[]
  onboardingTimeEntries            OnboardingTimeEntry[]
  onboardingHistory                OnboardingHistory[]
  operationActivities              OperationActivity[]        @relation("OperationResponsible")
  operationTimeEntries             OperationTimeEntry[]
  operationComments                OperationComment[]
  operationEvents                  OperationEvent[]
  operationClientProcesses         OperationClientProcess[]
  operationLedClients              Client[]                   @relation("OperationClientLeader")
  auditsSupervised                 Audit[]                    @relation("AuditSupervisor")
  auditFindingsAssigned            AuditFinding[]             @relation("AuditFindingOperator")
  auditInteractions                AuditInteraction[]
  auditChecklistReviewed           AuditChecklistItem[]       @relation("AuditChecklistReviewer")
  assignedServiceTickets           ServiceTicket[]            @relation("ServiceTicketAssignee")
  serviceTicketHistory             ServiceTicketHistory[]     @relation("ServiceTicketHistoryUser")
  payableClients                   Client[]                   @relation("ClientPayableResponsible")
  receivableClients                Client[]                   @relation("ClientReceivableResponsible")
  generalServiceClients            Client[]                   @relation("ClientGeneralResponsible")
  purchaseInvoicesCreated          PurchaseInvoice[]          @relation("PurchaseInvoiceCreator")
  contaAzulFinancialExportsCreated ContaAzulFinancialExport[] @relation("ContaAzulFinancialExportCreator")
  assistantConversations           AssistantConversation[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(OPERATOR)
  isTeamLeader   Boolean  @default(false)
  teamLeaderId   String?
  createdAt      DateTime @default(now())

  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamLeader       OrganizationMember?             @relation("OrganizationTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  teamMembers      OrganizationMember[]            @relation("OrganizationTeamLeader")
  inviteTokens     OrganizationMemberInviteToken[]
  authoredNotices  Notice[]                        @relation("NoticeAuthor")
  noticeRecipients NoticeRecipient[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([teamLeaderId])
}

model OrganizationMemberInviteToken {
  id        String   @id @default(cuid())
  memberId  String
  tokenHash String   @unique
  createdAt DateTime @default(now())

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Client {
  management ClientManagement?
  operationalMappings OperationalMapping[]
  id                      String        @id @default(cuid())
  organizationId          String
  name                    String
  normalizedName          String
  document                String?
  active                  Boolean       @default(true)
  operationalEmail        String?
  operationalEmailCc      String?
  cluster                 ClientCluster @default(C)
  operationLeaderId       String?
  serviceSquad            ClientSquad?
  payableResponsibleId    String?
  receivableResponsibleId String?
  generalResponsibleId    String?
  notionSquad             String?
  notionSyncedAt          DateTime?
  serviceAliases          String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operationLeader       User?        @relation("OperationClientLeader", fields: [operationLeaderId], references: [id], onDelete: SetNull)
  payableResponsible    User?        @relation("ClientPayableResponsible", fields: [payableResponsibleId], references: [id], onDelete: SetNull)
  receivableResponsible User?        @relation("ClientReceivableResponsible", fields: [receivableResponsibleId], references: [id], onDelete: SetNull)
  generalResponsible    User?        @relation("ClientGeneralResponsible", fields: [generalResponsibleId], references: [id], onDelete: SetNull)

  imports                   ImportJob[]
  employees                 Employee[]
  categoryRules             CategoryRule[]
  costCenters               CostCenter[]
  acquirers                 ClientAcquirer[]
  banks                     ClientBank[]
  cards                     ClientCard[]
  categoryMappings          ClientCategoryMapping[]
  onboardings               Onboarding[]
  operationConfigurations   OperationClientProcess[]
  operationActivities       OperationActivity[]
  audits                    Audit[]
  serviceTickets            ServiceTicket[]
  emailIdentities           ClientEmailIdentity[]
  noticeLinks               NoticeClient[]
  contaAzulConnection       ContaAzulConnection?
  purchaseInvoices          PurchaseInvoice[]
  purchaseInvoiceRules      PurchaseInvoiceRule[]
  contaAzulFinancialExports ContaAzulFinancialExport[]
  assistantConversations    AssistantConversation[]
  whatsappIdentities        ClientWhatsAppIdentity[]

  @@unique([organizationId, normalizedName])
  @@unique([organizationId, document])
  @@index([organizationId])
  @@index([organizationId, active])
  @@index([operationLeaderId])
  @@index([payableResponsibleId])
  @@index([receivableResponsibleId])
  @@index([generalResponsibleId])
  @@index([cluster])
}

model ManagementSyncState {
  id String @id
  origin String
  configuredAt DateTime?
  setupError String?
  lastStartedAt DateTime?
  lastFinishedAt DateTime?
  leaseUntil DateTime?
  processed Int @default(0)
  failed Int @default(0)
  lastError String?
}

model ClientManagement {
  clientId String @id
  organizationId String
  snapshot Json?
  checkedAccounts Json @default("{}")
  notionPageId String?
  revision Int @default(1)
  refreshedAt DateTime?
  refreshLeaseUntil DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

model AssistantConversation {
  id                   String                      @id @default(cuid())
  organizationId       String
  userId               String
  clientId             String?
  title                String                      @default("Nova conversa")
  status               AssistantConversationStatus @default(ACTIVE)
  lastOpenAiResponseId String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages     AssistantMessage[]

  @@index([organizationId, userId, status, updatedAt])
  @@index([clientId, updatedAt])
}

model AssistantMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           AssistantMessageRole
  content        String
  attachments    Json?
  metadata       Json?
  createdAt      DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ContaAzulConnection {
  id                    String                    @id @default(cuid())
  organizationId        String
  clientId              String                    @unique
  status                ContaAzulConnectionStatus @default(CONNECTED)
  active                Boolean                   @default(true)
  encryptedAccessToken  String
  encryptedRefreshToken String
  tokenExpiresAt        DateTime
  scopes                String[]                  @default([])
  externalTenantId      String?
  externalTenantName    String?
  connectedByUserId     String?
  lastSyncAt            DateTime?
  lastError             String?
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices         PurchaseInvoice[]
  financialExports ContaAzulFinancialExport[]

  @@index([organizationId, active])
  @@index([tokenExpiresAt])
}

model PurchaseInvoice {
  id                        String                @id @default(cuid())
  organizationId            String
  clientId                  String
  connectionId              String?
  createdById               String
  source                    PurchaseInvoiceSource @default(XML_UPLOAD)
  sourceKey                 String
  accessKey                 String?
  number                    String
  series                    String?
  supplierName              String
  supplierDocument          String?
  supplierContaAzulId       String?
  supplierContaAzulName     String?
  issueDate                 DateTime
  competenceDate            DateTime
  dueDate                   DateTime
  totalProducts             Decimal               @db.Decimal(18, 2)
  totalInvoice              Decimal               @db.Decimal(18, 2)
  financialAccountId        String?
  financialAccountName      String?
  paymentMethod             String                @default("OUTRO")
  status                    PurchaseInvoiceStatus @default(PENDING_REVIEW)
  externalPurchaseId        String?
  externalPayableProtocolId String?
  sentAt                    DateTime?
  lastError                 String?
  rawXml                    String?
  metadata                  Json?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connection   ContaAzulConnection?         @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdBy    User                         @relation("PurchaseInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items        PurchaseInvoiceItem[]
  installments PurchaseInvoiceInstallment[]

  @@unique([clientId, sourceKey])
  @@index([organizationId, status, createdAt])
  @@index([clientId, issueDate])
  @@index([accessKey])
}

model PurchaseInvoiceInstallment {
  id                String                           @id @default(cuid())
  invoiceId         String
  installmentNumber Int
  externalNumber    String?
  dueDate           DateTime
  amount            Decimal                          @db.Decimal(18, 2)
  source            PurchaseInvoiceInstallmentSource @default(MANUAL_REQUIRED)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, installmentNumber])
  @@index([invoiceId, dueDate])
}

model PurchaseInvoiceItem {
  id                      String   @id @default(cuid())
  invoiceId               String
  lineNumber              Int
  productCode             String?
  description             String
  normalizedDescription   String
  ncm                     String?
  cfop                    String?
  unit                    String?
  quantity                Decimal  @db.Decimal(18, 6)
  unitValue               Decimal  @db.Decimal(18, 6)
  totalValue              Decimal  @db.Decimal(18, 2)
  allocationAmount        Decimal  @db.Decimal(18, 2)
  contaAzulCategoryId     String?
  contaAzulCategoryName   String?
  contaAzulCostCenterId   String?
  contaAzulCostCenterName String?
  learned                 Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
  @@index([normalizedDescription])
}

model PurchaseInvoiceRule {
  id                      String   @id @default(cuid())
  clientId                String
  supplierDocument        String
  productCode             String
  normalizedDescription   String
  contaAzulCategoryId     String
  contaAzulCategoryName   String
  contaAzulCostCenterId   String?
  contaAzulCostCenterName String?
  usageCount              Int      @default(1)
  lastUsedAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, supplierDocument, productCode, normalizedDescription])
  @@index([clientId, supplierDocument, productCode])
}

model ContaAzulFinancialExport {
  id                   String                         @id @default(cuid())
  organizationId       String
  clientId             String
  connectionId         String
  createdById          String
  module               ContaAzulFinancialExportModule
  sourceKey            String
  sourceName           String
  contactId            String
  contactName          String?
  financialAccountId   String
  financialAccountName String?
  settleRequested      Boolean                        @default(false)
  status               ContaAzulFinancialExportStatus @default(PROCESSING)
  lastError            String?
  metadata             Json?
  completedAt          DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connection   ContaAzulConnection            @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  createdBy    User                           @relation("ContaAzulFinancialExportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines        ContaAzulFinancialExportLine[]

  @@unique([clientId, module, sourceKey])
  @@index([organizationId, module, createdAt])
  @@index([clientId, status])
}

model ContaAzulFinancialExportLine {
  id                    String                             @id @default(cuid())
  exportId              String
  lineKey               String
  direction             ContaAzulFinancialDirection
  status                ContaAzulFinancialExportLineStatus @default(PENDING)
  competenceDate        DateTime
  dueDate               DateTime
  paymentDate           DateTime?
  description           String
  amount                Decimal                            @db.Decimal(18, 2)
  categoryName          String
  contaAzulCategoryId   String?
  costCenterName        String?
  contaAzulCostCenterId String?
  externalProtocolId    String?
  externalEventId       String?
  externalInstallmentId String?
  externalSettlementId  String?
  lastError             String?
  metadata              Json?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  export ContaAzulFinancialExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@unique([exportId, lineKey])
  @@index([exportId, status])
  @@index([externalProtocolId])
}

model ClientBank {
  id          String   @id @default(cuid())
  clientId    String
  bankName    String
  bankCode    String?
  agency      String?
  account     String
  accountType String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, active])
}

model ClientCard {
  id                 String   @id @default(cuid())
  clientId           String
  bankName           String
  normalizedBankName String
  brand              String
  lastFourDigits     String?
  nickname           String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, normalizedBankName, brand, lastFourDigits])
  @@index([clientId, active])
}

model ClientAcquirer {
  id             String              @id @default(cuid())
  clientId       String
  name           String
  normalizedName String
  receiptRule    AcquirerReceiptRule @default(WITHOUT_ADVANCE)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  client Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rates  ClientAcquirerRate[]

  @@unique([clientId, normalizedName])
  @@index([clientId, active])
}

model ClientAcquirerRate {
  id               String                  @id @default(cuid())
  clientAcquirerId String
  transactionType  AcquirerTransactionType
  installments     Int                     @default(1)
  brand            String?
  normalizedBrand  String?
  expectedRate     Decimal                 @db.Decimal(7, 4)
  tolerance        Decimal                 @default(0.01) @db.Decimal(7, 4)
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  clientAcquirer ClientAcquirer @relation(fields: [clientAcquirerId], references: [id], onDelete: Cascade)

  @@unique([clientAcquirerId, transactionType, installments, normalizedBrand])
  @@index([clientAcquirerId, active])
}

model Category {
  sourceClientId String?
  remoteId       String?
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  normalizedName String
  code           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent              Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Category[]              @relation("CategoryHierarchy")
  categoryMappings    ClientCategoryMapping[] @relation("MappedCategory")
  subcategoryMappings ClientCategoryMapping[] @relation("MappedSubcategory")

  @@unique([organizationId, parentId, normalizedName])
  @@unique([organizationId, sourceClientId, remoteId])
  @@index([organizationId, active])
  @@index([parentId])
}

model ImportJob {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  userId         String
  module         ImportModule
  status         ImportStatus @default(UPLOADED)
  originalName   String
  storagePath    String?
  parserId       String?
  parserVersion  String?
  confidence     Decimal?     @db.Decimal(5, 2)
  expectedTotal  Decimal?     @db.Decimal(18, 2)
  parsedTotal    Decimal?     @db.Decimal(18, 2)
  difference     Decimal?     @db.Decimal(18, 2)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user          User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions  ParsedTransaction[]
  parserRun     ParserRun?
  brasilmedRows BrasilmedReconciliationRow[]

  @@index([organizationId, module, createdAt])
  @@index([clientId])
}

model ParsedTransaction {
  id          String          @id @default(cuid())
  importJobId String
  date        DateTime
  description String
  amount      Decimal         @db.Decimal(18, 2)
  type        TransactionType
  document    String?
  category    String?
  costCenter  String?
  sourcePage  Int?
  sourceLine  String?
  selected    Boolean         @default(true)
  metadata    Json?
  createdAt   DateTime        @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, date])
}

